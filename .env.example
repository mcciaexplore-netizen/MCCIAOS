# Every variable the code reads. Copy to .env and fill in what you need.
# .env is gitignored; this file is committed and must never hold real values.

# ---- Data store -------------------------------------------------------------
# Neon Postgres. When unset the app falls back to a local JSON file store at
# server/data/records.json — enough to boot, but the Work Tracker, Consultations
# and Workshops modules all require Postgres and will refuse without it.
# Run db/migrations.sql, then db/work-tracker.sql, against the database first.
DATABASE_URL=

# ---- Settings password ------------------------------------------------------
# Gates the Settings *screen*. Not an API credential: PRD.md:33 and TRD.md:42
# specify this app has no authentication, and every endpoint is open by design.
ADMIN_SETTINGS_PASSWORD=

# The older name for the same thing, still read so an existing deployment does
# not lose access. Set ADMIN_SETTINGS_PASSWORD on anything new.
SETTINGS_PASSCODE=

# ---- Daily export to Google Sheets (optional) -------------------------------
# Leave all four blank and the app runs unchanged; the export endpoint answers
# 501 naming what is missing. See the README for how to obtain them.

# The service account's client_email, from its JSON key.
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# The service account's private_key, from the same JSON key. Keep the quotes and
# the literal \n sequences exactly as they appear there — do not turn them into
# real line breaks, and do not drop the BEGIN/END lines. One very long line.
GOOGLE_PRIVATE_KEY=

# The id from the spreadsheet URL: docs.google.com/spreadsheets/d/<this>/edit
SHEETS_SPREADSHEET_ID=

# Any long random string, so the export endpoint is not open to the internet.
# Generate one with: openssl rand -hex 32
CRON_SECRET=

# ---- Daily digest emails (optional) ------------------------------------------
# Leave both blank and the export runs unchanged; no digest is sent and nothing
# else about the app is affected. See the README for how to obtain the app
# password.

MAIL_USER=

# A 16-character Gmail App Password for that account (not its login password).
# Google Account -> Security -> 2-Step Verification -> App passwords.
MAIL_APP_PASSWORD=

# Display name on the "From" header. Defaults to "MCCIA OS" if left blank.
MAIL_FROM_NAME=

# ---- Testing ----------------------------------------------------------------
# A throwaway Neon branch. The test suites refuse to run without it, and refuse
# if it equals DATABASE_URL — writing test rows to the live database has
# destroyed real data here before.
# Neon console -> Branches -> New Branch -> copy its connection string.
TEST_DATABASE_URL=
