# Data store. When CONVEX_URL is unset the app falls back to a local
# file-backed store at server/data/records.json, so it runs with no setup.
#
# Set this only AFTER the Convex functions in convex/ have been deployed to
# the target deployment (npx convex login && npx convex deploy) — otherwise
# every request fails because records:* does not exist yet.
CONVEX_URL=https://neat-jaguar-177.convex.cloud

# Legacy/alternative production target described in TRD.md. Unused while
# CONVEX_URL is set.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
