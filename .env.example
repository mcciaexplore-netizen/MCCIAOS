# Data store. When DATABASE_URL is unset the app uses a local file-backed
# store at server/data/records.json, so it runs with no setup.
#
# Neon (Postgres). Run db/migrations.sql against the database first.
DATABASE_URL=

# ---- Admin access -----------------------------------------------------------
# The password for the Settings page and every admin-only endpoint.
#
# Verified only on the server; it is never sent to the browser, never logged,
# and never returned by any route. A successful sign-in sets an HttpOnly,
# SameSite=Strict cookie that expires after 8 hours.
#
# Required in production: with this unset a deployed instance refuses every
# sign-in rather than falling back to a default.
ADMIN_SETTINGS_PASSWORD=

# The daily Google Sheets export needs four more variables. They are not listed
# here on purpose — see the README for what they are and how to obtain them.
