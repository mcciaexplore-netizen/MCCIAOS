# Data store. When DATABASE_URL is unset the app uses a local file-backed
# store at server/data/records.json, so it runs with no setup.
#
# Neon (Postgres). Run db/migrations.sql against the database first.
DATABASE_URL=

# ---- Settings passcode ------------------------------------------------------
# Gates the Settings page and every edit to already-recorded work.
# Required in production. Development falls back to a default if left blank.
SETTINGS_PASSCODE=

# The daily Google Sheets export needs four more variables. They are not listed
# here on purpose — see the README for what they are and how to obtain them.
