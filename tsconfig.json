{
  "files": [],
  "references": [
    { "path": "./tsconfig.app.json" },
    { "path": "./tsconfig.node.json" }
  ],
  // Solution-style config: the referenced projects above do the real work.
  // The `paths` entry is repeated here so any tool that reads only the root
  // tsconfig can still resolve the @/ alias — server/handlers.ts pulls in
  // @/schemas -> @/constants, and without it those imports fail to resolve.
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
